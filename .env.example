DEADLINE_REVIEW_DAYS=7
DEADLINE_EXAM_DAYS=30
DEADLINE_WARN_REVIEW_DAYS=2
DEADLINE_WARN_EXAM_DAYS=7

OWNER_DB_PASSWORD=owner_secret
