APP_ENV=dev
HTTP_ADDR=:8080
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://ppkpt_app:secret@localhost:5432/ppkpt?sslmode=disable
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ppkpt-evidence
S3_USE_SSL=false
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_REQUEST=10
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
