    {
      "name": "3. Login berhasil",
      "item": [
        {
          "name": "Login dengan password sementara -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const setCookie = pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).join('\\n');",
                  "pm.test('role SATGAS', () => pm.expect(j.user.role).to.eql('SATGAS'));",
                  "pm.test('akun baru wajib ganti password', () => pm.expect(j.user.must_change_password).to.eql(true));",
                  "pm.test('tidak ada hash/password di body', () => pm.expect(pm.response.text()).to.not.match(/password_hash|\"password\"/i));",
                  "pm.test('cookie ppkpt_session HttpOnly', () => { pm.expect(setCookie).to.include('ppkpt_session='); pm.expect(setCookie).to.match(/HttpOnly/i); });",
                  "pm.test('cookie SameSite=Lax', () => pm.expect(setCookie).to.match(/SameSite=Lax/i));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
