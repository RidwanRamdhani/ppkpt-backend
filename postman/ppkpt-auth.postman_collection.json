{
  "info": {
    "_postman_id": "ppkpt-auth-phase5",
    "name": "PPKPT - Autentikasi (Phase 5)",
    "description": "Uji modul autentikasi: login, sesi cookie, ganti password, logout, penguncian akun, CSRF.\n\nLangkah: 1) bash scripts/prepare-postman.sh  2) import environment hasilnya  3) jalankan API dengan RATE_LIMIT_AUTH_PER_MINUTE=1000  4) jalankan koleksi ini berurutan (Collection Runner).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Middleware CSRF API memeriksa header Origin pada request yang mengubah data.",
          "pm.request.headers.upsert({ key: 'Origin', value: pm.variables.get('origin') });"
        ]
      }
    }
  ],
