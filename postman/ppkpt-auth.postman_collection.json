      "name": "2. Login gagal",
      "item": [
        {
          "name": "Password salah -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.collectionVariables.set('msg_wrong', pm.response.json().error.message);",
                  "const setCookie = pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).join('\\n');",
                  "pm.test('tidak ada cookie sesi', () => pm.expect(setCookie).to.not.include('ppkpt_session='));"
                ]
              }
            }
